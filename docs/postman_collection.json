{
  "info": {
    "name": "E-Commerce REST API - Machine Test",
    "_postman_id": "7b823e20-746a-493a-810a-b326cb68e145",
    "description": "Comprehensive Postman collection for the Node.js/Express/MongoDB E-commerce REST API.\nFeatures:\n- User & Admin JWT Authentication & Profile\n- Multi-Level Category Management (Tree hierarchy & circular dependency check)\n- Products with Multi-Level Category Descendant Filtering\n- Order Placement with Backend Price Calculation & Atomic Stock Handling\n- Cart Management (Guest & Customer)\n- Admin User Management (Activation/Deactivation)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "customerToken", "value": "", "type": "string" },
    { "key": "guestToken", "value": "", "type": "string" },
    { "key": "sampleCategoryId", "value": "", "type": "string" },
    { "key": "sampleProductId", "value": "", "type": "string" },
    { "key": "sampleOrderId", "value": "", "type": "string" },
    { "key": "sampleUserId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Authentication & Users",
      "item": [
        {
          "name": "Register Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"System Admin\",\n  \"email\": \"admin@ecommerce.com\",\n  \"password\": \"Admin@1234\",\n  \"role\": \"admin\",\n  \"phone\": \"+91 9999988888\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.token) {",
                  "  pm.collectionVariables.set('adminToken', res.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Priya Sharma\",\n  \"email\": \"customer@ecommerce.com\",\n  \"password\": \"Customer@1234\",\n  \"role\": \"customer\",\n  \"phone\": \"+91 9876543210\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.token) {",
                  "  pm.collectionVariables.set('customerToken', res.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@ecommerce.com\",\n  \"password\": \"Admin@1234\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.token) {",
                  "  pm.collectionVariables.set('adminToken', res.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@ecommerce.com\",\n  \"password\": \"Customer@1234\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.token) {",
                  "  pm.collectionVariables.set('customerToken', res.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/profile", "host": ["{{baseUrl}}"], "path": ["api", "auth", "profile"] }
          }
        },
        {
          "name": "Admin - List Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/users?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["api", "users"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "10" }] }
          }
        },
        {
          "name": "Admin - Deactivate User",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": false\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/users/{{sampleUserId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{sampleUserId}}", "status"] }
          }
        }
      ]
    },
    {
      "name": "2. Multi-Level Categories",
      "item": [
        {
          "name": "Get Category Tree (Hierarchy)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/categories/tree", "host": ["{{baseUrl}}"], "path": ["api", "categories", "tree"] }
          }
        },
        {
          "name": "Get All Categories (Flat)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/categories", "host": ["{{baseUrl}}"], "path": ["api", "categories"] }
          }
        },
        {
          "name": "Admin - Create Root Category (Electronics)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Electronics\",\n  \"description\": \"Consumer electronics & gadgets\",\n  \"parentId\": null\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/categories", "host": ["{{baseUrl}}"], "path": ["api", "categories"] }
          }
        },
        {
          "name": "Admin - Create Subcategory (Mobiles under Electronics)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mobiles\",\n  \"description\": \"Smartphones and feature phones\",\n  \"parentId\": \"{{sampleCategoryId}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/categories", "host": ["{{baseUrl}}"], "path": ["api", "categories"] }
          }
        },
        {
          "name": "Admin - Update Category (Validates Circular Dependency)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Smart Mobiles\",\n  \"description\": \"All smartphones updated\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/categories/{{sampleCategoryId}}", "host": ["{{baseUrl}}"], "path": ["api", "categories", "{{sampleCategoryId}}"] }
          }
        }
      ]
    },
    {
      "name": "3. Products",
      "item": [
        {
          "name": "List Products (Search, Category Filter & Sort)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products?search=&category=electronics&sort=newest&page=1&limit=12",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "search", "value": "" },
                { "key": "category", "value": "electronics", "description": "Returns products in Electronics AND all its subcategories (Mobiles, Samsung, OnePlus, etc.)" },
                { "key": "sort", "value": "newest" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "12" }
              ]
            }
          }
        },
        {
          "name": "Get Product by ID / Slug",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/products/{{sampleProductId}}", "host": ["{{baseUrl}}"], "path": ["api", "products", "{{sampleProductId}}"] }
          }
        },
        {
          "name": "Admin - Create Product",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Samsung Galaxy S24 Ultra 5G\",\n  \"sku\": \"SAM-S24U-256\",\n  \"description\": \"Flagship smartphone with Snapdragon 8 Gen 3 and 200MP camera\",\n  \"price\": 129999,\n  \"salePrice\": 119999,\n  \"stock\": 50,\n  \"category\": \"{{sampleCategoryId}}\",\n  \"status\": \"active\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] }
          }
        }
      ]
    },
    {
      "name": "4. Orders",
      "item": [
        {
          "name": "Place Order (Customer - Atomic Stock Reduction)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{sampleProductId}}\",\n      \"quantity\": 1\n    }\n  ],\n  \"shippingAddress\": {\n    \"fullName\": \"Priya Sharma\",\n    \"phone\": \"+91 9876543210\",\n    \"street\": \"124 Lotus Boulevard\",\n    \"city\": \"Noida\",\n    \"state\": \"Uttar Pradesh\",\n    \"zipCode\": \"201304\",\n    \"country\": \"India\"\n  },\n  \"paymentMethod\": \"COD\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/orders", "host": ["{{baseUrl}}"], "path": ["api", "orders"] }
          }
        },
        {
          "name": "Customer - Get My Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/orders/my-orders", "host": ["{{baseUrl}}"], "path": ["api", "orders", "my-orders"] }
          }
        },
        {
          "name": "Admin - Get All Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/orders?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["api", "orders"] }
          }
        },
        {
          "name": "Admin - Update Order Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Confirmed\",\n  \"note\": \"Payment verified, ready for packaging\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/orders/{{sampleOrderId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "orders", "{{sampleOrderId}}", "status"] }
          }
        }
      ]
    },
    {
      "name": "5. Cart (Guest & User)",
      "item": [
        {
          "name": "Get Cart",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-guest-token", "value": "{{guestToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/cart", "host": ["{{baseUrl}}"], "path": ["api", "cart"] }
          }
        },
        {
          "name": "Add Item to Cart",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-guest-token", "value": "{{guestToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{sampleProductId}}\",\n  \"quantity\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/cart/items", "host": ["{{baseUrl}}"], "path": ["api", "cart", "items"] }
          }
        }
      ]
    }
  ]
}
